<!--
  Buddy's Buddy — Dalamud plugin host.

  Uses the Dalamud.NET.Sdk MSBuild SDK, which references the local Dalamud dev assemblies
  (%AppData%\XIVLauncher\addon\Hooks\dev) and runs DalamudPackager on build.

  The SDK version determines the emitted DalamudApiLevel, which must match the installed Dalamud
  or the plugin is rejected as outdated. Dalamud 15.0.3.0 uses **API level 14**, confirmed against
  all 63 plugins in %AppData%\XIVLauncher\installedPlugins (checked 2026-07-28) — so pin the 14.x
  SDK, not 15.x. Verify after changing: the generated bin\<cfg>\BuddysBuddy.json must read
  "DalamudApiLevel": 14.
-->
<Project Sdk="Dalamud.NET.Sdk/14.0.2">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <AssemblyName>BuddysBuddy</AssemblyName>
    <RootNamespace>BuddysBuddy</RootNamespace>

    <Version>0.1.0</Version>
    <Authors>NoctusDev</Authors>
    <Description>A host plugin for a collection of small FFXIV quality-of-life modules.</Description>
  </PropertyGroup>

</Project>
