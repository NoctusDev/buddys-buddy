<!--
  Buddy's Buddy — Dalamud plugin host.

  Uses the Dalamud.NET.Sdk MSBuild SDK, which references the local Dalamud dev assemblies
  (%AppData%\XIVLauncher\addon\Hooks\dev) and runs DalamudPackager on build.

  The SDK version determines the emitted DalamudApiLevel, which must match the Dalamud this
  machine actually runs or the plugin is rejected as outdated.

  That Dalamud lives at d:\Multibox\Glumishxiv3 (see Directory.Build.props), not the SDK's default
  %AppData%\XIVLauncher — and it is on **API level 15**, confirmed from its own installedPlugins
  (83 plugins on 15, checked 2026-07-28). Do not trust the %AppData% install: it is a stale copy on
  API 14 and reading it is what produced an "outdated" plugin.

  Verify after any change: bin\<cfg>\BuddysBuddy.json must read "DalamudApiLevel": 15.
  `dotnet run scripts/verify.cs` checks this against the live install.
-->
<Project Sdk="Dalamud.NET.Sdk/15.0.0">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <AssemblyName>BuddysBuddy</AssemblyName>
    <RootNamespace>BuddysBuddy</RootNamespace>

    <Version>0.4.0</Version>
    <Authors>NoctusDev</Authors>
    <Description>A host plugin for a collection of small FFXIV quality-of-life modules.</Description>
  </PropertyGroup>

</Project>
