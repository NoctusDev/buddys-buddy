<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <AssemblyName>VenueAudio</AssemblyName><RootNamespace>VenueAudio</RootNamespace>
    <Version>0.3.0</Version><Authors>NoctusDev</Authors><Description>Live venue audio with in-game broadcasting and listening.</Description>
    <ImplicitUsings>enable</ImplicitUsings><AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../VenueAudio.Core/VenueAudio.Core.csproj" />
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <PackageReference Include="NAudio.WinMM" Version="2.2.1" />
    <PackageReference Include="Concentus" Version="1.1.7" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Tools\**\*" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="images\icon.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
