<Project>

  <!--
    Point the Dalamud SDK at the Dalamud this machine actually runs.

    XIVLauncher here is launched with a custom roamingPath argument of "d:\Multibox\Glumishxiv3"
    (a multibox setup), so the live Dalamud is NOT in the SDK's default location of
    %AppData%\XIVLauncher\addon\Hooks\dev.
    That default path also exists on this machine but is a stale March install on an older API
    level — building against it produces a plugin the running Dalamud rejects as outdated.

    Dalamud.NET.Sdk's Sdk.props imports Microsoft.NET.Sdk (and therefore this file) before it
    resolves DalamudLibPath, and prefers DALAMUD_HOME over its platform default, so setting the
    property here wins. A real DALAMUD_HOME environment variable still overrides this.

    To find the correct path on another machine: check which Dalamud.dll the game process has
    loaded, or read the roamingPath argument off the running XIVLauncher process.
  -->
  <PropertyGroup Condition="'$(DALAMUD_HOME)' == ''">
    <_LiveDalamudHome>d:\Multibox\Glumishxiv3\addon\Hooks\dev</_LiveDalamudHome>
    <DALAMUD_HOME Condition="Exists('$(_LiveDalamudHome)')">$(_LiveDalamudHome)</DALAMUD_HOME>
  </PropertyGroup>

</Project>
